{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(chat|threads|settings|providers|health|ag-ui|copilotkit|generative_ui|a2ui|auth|marketplace|api)",
      "destination": "https://orbit-backend-txwt.onrender.com/$1"
    },
    {
      "source": "/(chat|threads|settings|providers|health|ag-ui|copilotkit|generative_ui|a2ui|auth|marketplace|api)/(.*)",
      "destination": "https://orbit-backend-txwt.onrender.com/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
